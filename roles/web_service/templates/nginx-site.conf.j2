# Managed by salvomazzaglia.infrastructure_automation.web_service
server {
    listen {{ aial_web_listen_port | int }} default_server;
    listen [::]:{{ aial_web_listen_port | int }} default_server;
    server_name _;

    root {{ aial_web_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /healthz {
        default_type text/plain;
        return 200 'ok\n';
    }
}
