{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/salvomazzaglia/ansible-infrastructure-automation-lab/schemas/drift-report.schema.json",
  "title": "Ansible Infrastructure Automation Lab — Drift Report",
  "description": "Configuration drift findings from check-mode / desired-state comparison. Synthetic samples use .example.invalid hosts only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "check_mode",
    "findings"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "drift-report"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "banner": {
      "type": "string",
      "description": "Optional synthetic-data banner for sample reports."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "playbook": {
      "type": ["string", "null"]
    },
    "check_mode": {
      "type": "boolean",
      "description": "True when findings were produced under Ansible check mode."
    },
    "inventory_groups": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compliant": { "type": "integer", "minimum": 0 },
        "change_required": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "role",
        "task",
        "expected_change",
        "changed",
        "status",
        "severity",
        "reason",
        "check_mode",
        "timestamp"
      ],
      "properties": {
        "host": {
          "type": "string",
          "description": "Inventory host alias."
        },
        "role": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "expected_change": {
          "type": "boolean",
          "description": "Whether desired state differs from observed state."
        },
        "changed": {
          "type": "boolean",
          "description": "Whether Ansible reported changed (or would change in check mode)."
        },
        "status": {
          "type": "string",
          "enum": [
            "compliant",
            "change_required",
            "unavailable",
            "failed",
            "skipped"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Importance / severity of the drift finding."
        },
        "importance": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Alias for severity when used by consumers."
        },
        "reason": {
          "type": "string"
        },
        "check_mode": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
